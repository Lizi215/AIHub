<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      统一日志格式：全链路同一 traceId，且必须出现在每条日志中（docs/SECURITY.md §4）。
      本文件位于 aihub-common，所有服务共享一份配置，避免各服务各写一套导致格式漂移。
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-no-trace}] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
