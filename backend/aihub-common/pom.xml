<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aihub</groupId>
        <artifactId>aihub</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>aihub-common</artifactId>
    <name>aihub-common</name>
    <description>公共能力：统一响应体、错误码、全局异常、Jackson/时间/分页配置、traceId 链路。禁止放置任何业务逻辑与业务实体。</description>

    <dependencies>
        <!--
          optional=true：仅为 common 自身编译提供 Servlet / MVC API，
          不会传递给依赖方。Gateway 基于 WebFlux，因此不会被引入 Servlet 栈。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          WebFlux 同样是 optional：只为 common 提供 Reactor / WebFilter 的编译期可见性，
          用于承载 Gateway 侧的 traceId 过滤器，不会把 Reactive 栈传递给 MVC 服务。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!--
          optional：消费幂等守卫需要 Redis 模板。设为 optional 以免把 Redis 强加给不使用它的服务。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          optional：为 common 提供 BaseEntity / 分页拦截器等 MyBatis-Plus 基础设施的编译期依赖。
          不使用数据库的服务（如 Gateway）不会被传递引入 JDBC。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 分页插件所在模块（MP 3.5.9+ 独立拆分，且不在聚合包中传递） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          optional：出站事件投递（RocketMQEventDispatcher）需要 RocketMQTemplate。
          与 Redis / MyBatis 同样的处理——不使用 MQ 的服务不会被传递引入。
        -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          optional：OutboxDispatchSupport 用 TransactionSynchronizationManager（spring-tx）。
          已由 MyBatis-Plus 传递提供，这里显式声明以免依赖传递关系变化后编译不过。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
