# AIHub 环境变量样例
#
# 用法：复制为 deploy/.env（或项目根 .env）后按需修改。
# 禁止把真实的 .env 提交到 Git（见 docs/SECURITY.md §1）。

# ---------- 通用 ----------
TZ=Asia/Shanghai

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=aihub
MYSQL_USER=aihub
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
# 后端连接串（注意 serverTimezone 必须显式指定，禁止依赖 JVM 默认时区）
DB_URL=jdbc:mysql://127.0.0.1:3306/aihub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=aihub
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_HOST=127.0.0.1

# ---------- Elasticsearch（Search Service） ----------
# 官方 elasticsearch-java 客户端版本与服务端对齐（9.5.2）；Boot 只管理到 ES 8 的客户端
ES_URIS=http://127.0.0.1:9200
ES_BOOTSTRAP_ENABLED=true
ES_WAIT_FOR_REFRESH=true
# 定时对账：补齐事件缺失造成的索引缺口
RECONCILE_ENABLED=true
RECONCILE_LOOKBACK=24h

# ---------- RocketMQ（outbox 投递与索引消费） ----------
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL=5s
COMMUNITY_OUTBOX_ENABLED=true

# ---------- MinIO ----------
MINIO_ROOT_USER=aihub
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Nacos（注册中心） ----------
NACOS_ADDR=127.0.0.1:8848
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
# 本地无 Nacos 时置 false，可配合 simple discovery 静态实例启动
NACOS_ENABLED=true

# ---------- Apollo（配置中心） ----------
APOLLO_META=http://127.0.0.1:8090
APOLLO_PORT=8090
APOLLO_PORTAL_PORT=8070
APOLLO_ENABLED=true

# ---------- Sentinel ----------
SENTINEL_DASHBOARD_PORT=8858

# ---------- Elasticsearch ----------
ES_PORT=9200

# ---------- RocketMQ ----------
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_PROXY_PORT=8081

# ---------- 服务端口 ----------
GATEWAY_PORT=8080
USER_PORT=8081
ASSET_PORT=8082
FILE_PORT=8083
COMMUNITY_PORT=8084
AI_PORT=8085
SEARCH_PORT=8086

# ---------- JWT ----------
# 必填：Gateway 与所有业务服务共用同一密钥；留空会导致服务启动失败（禁止默认密钥）
# 生成示例：openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=aihub
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# ---------- 上传大小上限（中转模式会把字节驻留堆内存）----------
ASSET_MAX_UPLOAD_SIZE=50MB
ASSET_MAX_REQUEST_SIZE=50MB
ASSET_MAX_UPLOAD_BYTES=52428800
MINIO_MAX_SIZE_BYTES=52428800
MINIO_ALLOWED_EXTENSIONS=zip

# ---------- Gateway ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Feign 超时（禁止使用默认值，docs/BACKEND.md §3） ----------
FEIGN_CONNECT_TIMEOUT=3000
FEIGN_READ_TIMEOUT=30000

# ---------- AI / Agent（Phase 6） ----------
# AGENT_MODE=AUTO：有 AGENT_API_KEY 用真实模型，没有就自动降级到 mock（无 Key 也能跑通完整链路）
# 置 OPENAI 表示强制使用真实模型，此时缺 Key 会让服务启动失败（避免"以为在用模型，其实一直 mock"）
AGENT_MODE=AUTO
# OpenAI 兼容端点，可指向 OpenAI / DeepSeek / 通义等
AGENT_BASE_URL=https://api.openai.com
AGENT_API_KEY=
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.2
# 防护约束：步数上限 / 单任务超时 / 单次 Tool 超时 / Token 预算（docs/AGENT.md §7）
AGENT_MAX_STEPS=12
AGENT_TASK_TIMEOUT=60s
AGENT_TOOL_TIMEOUT=5s
AGENT_MAX_TOKENS=20000
# 不可信内容（README / 帖子正文）进入模型上下文前的截断上限
AGENT_MAX_UNTRUSTED_CHARS=1500
# 后台执行线程数与等待队列长度（队列满时直接拒绝新建任务）
AGENT_EXECUTOR_THREADS=4
AGENT_EXECUTOR_QUEUE=50
# MCP 客户端：默认关闭（本机无可用 MCP Server），需要时置 true 并配置 server
MCP_CLIENT_ENABLED=false
